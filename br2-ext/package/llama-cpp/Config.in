config BR2_PACKAGE_LLAMA_CPP
	bool "llama.cpp（本地推理引擎）"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	help
	  llama.cpp 是纯 C/C++ 的 LLM 推理引擎，不需要 Python、不需要
	  CUDA 也能在 CPU 上跑量化模型。shuios 用它作为内置推理后端：
	  shuiosd 通过 /v1/chat/completions（OpenAI 兼容）与它通信，
	  shui 的自然语言能力就来自这里。

	  本包只安装命令行与服务端：
	    llama-server   OpenAI 兼容的 HTTP 服务（默认 127.0.0.1:8080）
	    llama-cli      一次性命令行推理
	    llama-bench    性能基准

	  GPU 加速（CUDA/Vulkan）在 v0.1 里刻意不做：先把 CPU 路径跑通，
	  避免把镜像体积和构建复杂度一次性拉满。见 docs/04-路线图.md。

	  https://github.com/ggml-org/llama.cpp

comment "llama.cpp 需要 C++ 工具链与线程支持"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_MMU
