# shuios 内核配置片段 — 叠加在 x86_64_defconfig 之上
#
# 目标：一个能跑智能体运行时、能本地推理、能在 QEMU 和真机上启动的最小内核。
# 原则：启动必需的一切内置（=y），硬件驱动尽量做成模块。

# ---- 基础启动 ----------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BOOTPARAM_HOTPLUG_CPU0=y
CONFIG_KVM_GUEST=y
CONFIG_HYPERVISOR_GUEST=y

# ---- 输入设备（真机键盘 / 串口控制台）---------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y

# ---- 显存 / GPU（模块，避免内核膨胀）----------------------------------
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
# QEMU 的 -vga std（bochs）需要这个 KMS 驱动；没有它 QEMU 里就没有
# /dev/dri/card0，Weston 会退到 headless 后端，屏幕上什么都看不到。
CONFIG_DRM_BOCHS=y
# VMware Workstation / ESXi 的 vmware-svga 设备需要 vmwgfx，否则 guest 里
# 没有 /dev/dri/card0（efifb 不是 DRM 设备），sway 无法启动。
CONFIG_DRM_VMWGFX=y
# 桌面（Wayland/GBM）需要的 DRM 辅助设施
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_DMA_FENCE_TRACE=n
# 鼠标（weston 的 libinput 需要 evdev 事件）
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_HID_LOGITECH=m
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m

# ---- 音频：VMware/QEMU HDA + 真机常见 codec ----------------------------
# x86_64_defconfig 只带了 snd-hda-intel 控制器，codec 解析器全是 =n，
# 结果 /proc/asound/cards 是 "no soundcards"。这里把常用 codec 内置。
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_HDMI=y
# 备选：VMware 的 Sound Blaster AudioPCI 后端（sound.virtualDev = "es1371"）
CONFIG_SND_ENS1371=y
CONFIG_SND_USB_AUDIO=y

# ---- 文件系统：只读根 + 数据分区 + 容器 --------------------------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y
CONFIG_AUTOFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y

# ---- cgroup v2：智能体资源隔离的地基 -----------------------------------
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_PSI=y

# ---- 安全：沙箱所需的原语 ----------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_YAMA=y
CONFIG_KEYS=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ---- 性能 / AI 工作负载 -------------------------------------------------
CONFIG_IO_URING=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NR_CPUS=256
CONFIG_SMP=y
CONFIG_NUMA=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_PADATA=y

# ---- 网络 --------------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_INET6=y
CONFIG_PACKET=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y

# ---- 存储与虚拟化（QEMU 测试 + 真机常见硬件）--------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_BMDMA=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y

# ---- 常见网卡（真机 / 虚拟机）------------------------------------------
CONFIG_E1000=y
CONFIG_E1000E=m
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_8139TOO=m

# ---- 无线（cfg80211/mac80211 已由 x86_64_defconfig 带出）----------------
# hwsim：没有物理无线网卡时的验收通道（networkmanager + hostapd 端到端）。
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MAC80211_HWSIM=m
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_RFKILL=y

# ---- 精简 --------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FTRACE=n
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n
