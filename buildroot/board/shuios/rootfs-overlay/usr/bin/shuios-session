#!/bin/sh
# ═══════════════════════════════════════════════════════════
#  氵系统 会话启动脚本
#
#  职责：准备好 Wayland 运行环境，然后让 cage 全屏拉起 shuios。
#
#  cage 是 kiosk 式 Wayland 合成器 —— 它只做一件事：
#  把唯一的客户端铺满整块屏幕。没有窗口管理、没有标题栏。
#
#  对用户来说，开机后看到的就是 shuios，看不到 cage。
# ═══════════════════════════════════════════════════════════

# 等 GPU 驱动就绪（内核 i915 初始化需要一点时间）
for i in $(seq 1 30); do
    [ -e /dev/dri/card0 ] && break
    sleep 0.5
done

if [ ! -e /dev/dri/card0 ]; then
    echo "[shuios-session] 未找到 /dev/dri/card0 —— 显卡驱动可能没加载"
fi

# ── Wayland 运行目录 ──────────────────────────────────────
export XDG_RUNTIME_DIR=/run/shuios
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# ── Qt 平台 ───────────────────────────────────────────────
export QT_QPA_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland

# 软件渲染兜底：若 GPU 不可用，至少还能起来（会很慢）
# 设 SHUIOS_SOFTWARE=1 可强制启用
if [ "$SHUIOS_SOFTWARE" = "1" ] || [ ! -e /dev/dri/card0 ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
fi

# ── 大脑配置 ──────────────────────────────────────────────
# API Key 从 /etc/shuios/key 读取（首次开机可插 U 盘写入）
if [ -f /etc/shuios/key ]; then
    SHUIOS_DEEPSEEK_KEY=$(cat /etc/shuios/key)
    export SHUIOS_DEEPSEEK_KEY
fi

# ── 启动 ──────────────────────────────────────────────────
echo "[shuios-session] 启动氵系统..."

# cage 的写法在不同版本略有差异，两种都试
if cage -- /usr/bin/shuios 2>/dev/null; then
    exit 0
else
    exec cage /usr/bin/shuios
fi
