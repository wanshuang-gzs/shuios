# ═══════════════════════════════════════════════════════════
#  氵系统 inittab
#
#  这是"身体"的起点：开机挂载完文件系统后，
#  不在 tty1 上启动 login，而是直接启动 shuios 会话。
#
#  没有登录管理器，没有桌面环境，没有 tty 提示符。
#  开机 = 氵系统。
# ═══════════════════════════════════════════════════════════

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /dev
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock /run/log
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# ── 核心：tty1 上启动氵系统 ───────────────────────────────
# respawn: 崩溃后自动重启，用户永远不会掉到 shell
::respawn:/usr/bin/shuios-session

# 备用终端：Ctrl+Alt+F2 可进（调试用）
::respawn:/sbin/getty -L tty2 0 vt100

# 重启 / 关机
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
::shutdown:/sbin/swapoff -a
