# ═══════════════════════════════════════════════════════════
#  氵系统 shuios — Buildroot 配置 (x86_64)
#
#  目标: 产出一个可写 U 盘、可引导、开机直进 shuios 的镜像
#
#  用法:
#    make BR2_EXTERNAL=$(pwd)/buildroot shuios_x86_64_defconfig
#    make -j$(nproc)
# ═══════════════════════════════════════════════════════════

# ── 架构 ──────────────────────────────────────────────────
BR2_x86_64=y
BR2_x86_corei7=y

# ── 工具链 ────────────────────────────────────────────────
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# ── 系统 ──────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="shuios"
BR2_TARGET_GENERIC_ISSUE="氵系统 shuios — AI-native"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# ── 文件系统 ──────────────────────────────────────────────
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"

# 混合 ISO：既能刻盘，也能 dd 到 U 盘
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
BR2_TARGET_ROOTFS_ISO9660_LABEL="SHUIOS"

# ── 内核 ──────────────────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SHUIOS_PATH)/board/shuios/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# ── overlay / 脚本 ────────────────────────────────────────
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SHUIOS_PATH)/board/shuios/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SHUIOS_PATH)/board/shuios/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SHUIOS_PATH)/board/shuios/post-image.sh"

# ── Wayland 图形栈 ────────────────────────────────────────
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_LIBDRM=y

# Mesa：Intel 核显走 iris 驱动（N100 属于 Gen12）
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y

# kiosk 合成器（第一版的"屏幕接管者"）
BR2_PACKAGE_CAGE=y

# ── Qt6 ───────────────────────────────────────────────────
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WAYLAND=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6QUICKCONTROLS2=y
BR2_PACKAGE_QT6SVG=y

# ── 字体（中文必需）───────────────────────────────────────
BR2_PACKAGE_DEJAVU=y
# 文泉驿正黑：中文字形。Buildroot 若无此包，见 post-build.sh 的兜底
BR2_PACKAGE_WQY_ZENHEI=y

# ── shuios 本体 ───────────────────────────────────────────
BR2_PACKAGE_SHUIOS=y

# ── 基础工具（调试用，可后期裁掉）─────────────────────────
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_PROCPS_NG=y
